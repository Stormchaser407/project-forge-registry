#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'HELP'
Usage:
  ./scripts/project-forge-install-dashboard-desktop [--dry-run|--install]

Purpose:
  Install a user-local Project Forge Dashboard desktop entry and local SVG icon.
  Default mode is dry-run.

Options:
  --dry-run  Print the files that would be written without creating them.
  --install  Write the desktop entry and icon, backing up existing files first.
  -h, --help Show this help text.

Safety:
  - dry-run first by default
  - writes only the expected user-local desktop/icon files in install mode
  - backs up existing different files before overwrite
  - no marker writes
  - no remotes
  - no push/fetch
  - no package installs
  - no network calls
  - no editor launching
  - no commits
  - no tags
HELP
}

INSTALL=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run)
      INSTALL=0
      shift
      ;;
    --install)
      INSTALL=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "ERROR: unknown argument: $1" >&2
      echo "Usage: ./scripts/project-forge-install-dashboard-desktop [--dry-run|--install]" >&2
      exit 2
      ;;
  esac
done

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"
cd "$REPO_ROOT"

ICON_DIR="$HOME/.local/share/icons/neon-district-project-forge"
APP_DIR="$HOME/.local/share/applications"
DESKTOP_DIR="$HOME/Desktop"
ICON_PATH="$ICON_DIR/project-forge-dashboard.svg"
APP_DESKTOP_PATH="$APP_DIR/project-forge-dashboard.desktop"
USER_DESKTOP_PATH="$DESKTOP_DIR/project-forge-dashboard.desktop"
TIMESTAMP="$(date +%Y%m%d-%H%M%S)"
TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT

EXEC_LINE="bash -lc 'cd \"${REPO_ROOT}\" && ./scripts/project-forge-dashboard --open'"

write_icon_template() {
  local target="$1"
  cat > "$target" <<'SVG'
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" role="img" aria-labelledby="title desc">
  <title id="title">Project Forge Dashboard</title>
  <desc id="desc">Local dashboard command board icon.</desc>
  <defs>
    <linearGradient id="plate" x1="0" x2="1" y1="0" y2="1">
      <stop offset="0" stop-color="#06080d"/>
      <stop offset=".58" stop-color="#111827"/>
      <stop offset="1" stop-color="#152318"/>
    </linearGradient>
    <filter id="glow" x="-40%" y="-40%" width="180%" height="180%">
      <feGaussianBlur stdDeviation="4" result="blur"/>
      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>
  <rect width="256" height="256" rx="24" fill="url(#plate)"/>
  <path d="M30 44h196v152H30z" fill="#09111d" stroke="#20e8ff" stroke-width="4"/>
  <path d="M48 71h58v38H48z" fill="#101827" stroke="#42ff9b" stroke-width="4" filter="url(#glow)"/>
  <path d="M122 71h86v38h-86z" fill="#101827" stroke="#ffc857" stroke-width="4"/>
  <path d="M48 128h160v46H48z" fill="#101827" stroke="#ff4fd8" stroke-width="4"/>
  <path d="M66 147h30M113 147h32M162 147h28" stroke="#edf7ff" stroke-width="6" stroke-linecap="round"/>
  <circle cx="62" cy="216" r="8" fill="#42ff9b" filter="url(#glow)"/>
  <circle cx="92" cy="216" r="8" fill="#ffc857" filter="url(#glow)"/>
  <circle cx="122" cy="216" r="8" fill="#ff3864" filter="url(#glow)"/>
  <path d="M152 216h44" stroke="#20e8ff" stroke-width="6" stroke-linecap="round"/>
  <path d="M38 32l180 194" stroke="#20e8ff" stroke-width="2" opacity=".12"/>
</svg>
SVG
}

write_desktop_template() {
  local target="$1"
  cat > "$target" <<DESKTOP
[Desktop Entry]
Type=Application
Name=Project Forge Dashboard
Comment=Refresh and open the local Project Forge dashboard
Exec=$EXEC_LINE
Icon=$ICON_PATH
Terminal=false
Categories=Development;Utility;
StartupNotify=true
DESKTOP
}

install_with_backup() {
  local source="$1"
  local target="$2"
  mkdir -p "$(dirname -- "$target")"
  if [[ -f "$target" ]]; then
    if cmp -s "$source" "$target"; then
      echo "Unchanged:"
      echo "  $target"
      return
    fi
    local backup="${target}.bak.${TIMESTAMP}"
    cp -- "$target" "$backup"
    echo "Backup:"
    echo "  $backup"
  fi
  cp -- "$source" "$target"
  chmod +x "$target"
  echo "Wrote:"
  echo "  $target"
}

ICON_TEMPLATE="$TMP_DIR/project-forge-dashboard.svg"
DESKTOP_TEMPLATE="$TMP_DIR/project-forge-dashboard.desktop"
write_icon_template "$ICON_TEMPLATE"
write_desktop_template "$DESKTOP_TEMPLATE"

echo "============================================================"
echo " PROJECT FORGE DASHBOARD DESKTOP INSTALLER"
echo "============================================================"
echo "Repo: $REPO_ROOT"
echo "Mode: $([[ "$INSTALL" == "1" ]] && echo install || echo dry-run)"
echo
echo "Icon:"
echo "  $ICON_PATH"
echo "Desktop launcher:"
echo "  $USER_DESKTOP_PATH"
echo "Application launcher:"
echo "  $APP_DESKTOP_PATH"
echo
echo "Launcher command:"
echo "  $EXEC_LINE"

if [[ "$INSTALL" != "1" ]]; then
  echo
  echo "Dry run only. No files were written."
  exit 0
fi

install_with_backup "$ICON_TEMPLATE" "$ICON_PATH"
install_with_backup "$DESKTOP_TEMPLATE" "$USER_DESKTOP_PATH"
install_with_backup "$DESKTOP_TEMPLATE" "$APP_DESKTOP_PATH"

if command -v update-desktop-database >/dev/null 2>&1; then
  update-desktop-database "$APP_DIR" >/dev/null 2>&1 || true
  echo "Refreshed desktop application cache with update-desktop-database."
else
  echo "update-desktop-database not found; skipped desktop database refresh."
fi

if command -v kbuildsycoca6 >/dev/null 2>&1; then
  kbuildsycoca6 >/dev/null 2>&1 || true
  echo "Refreshed KDE service cache with kbuildsycoca6."
else
  echo "kbuildsycoca6 not found; skipped KDE service cache refresh."
fi

echo
echo "Dashboard desktop installer complete."
